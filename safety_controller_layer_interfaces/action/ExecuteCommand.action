# ExecuteCommand.action
# Turn the rover by a relative heading change, then drive forward.
#
# Built as part of the safety_controller_layer_interfaces ament_cmake package
# (see ../package.xml and ../CMakeLists.txt). Run `colcon build` in a ROS2
# workspace to generate the ExecuteCommand action interface.

# --- Goal ---
float64 heading_degree   # relative heading change in degrees, CCW positive
float64 distance_m       # forward distance to drive in metres, non-negative
---
# --- Result ---
bool success             # true if both phases completed within their timeouts
string message           # human-readable outcome / abort reason
---
# --- Feedback ---
string phase             # current phase: "rotating" or "driving"
